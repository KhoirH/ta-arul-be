// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Assets {
  id    Int     @id @default(autoincrement())
  device_name String  @db.VarChar(100)
  asset_number  Int
  serial_number  String @db.VarChar(255)
  location  String @db.VarChar(255) @default("")
  asset_year  String? @db.VarChar(255)
  avability  Boolean @default(true)
  version  Int @default(1)
}

model Users {
  id    Int     @id @default(autoincrement())
  username String  @db.VarChar(100)
  password  String
}

model Employee {
  id    Int     @id @default(autoincrement())
  no_reg  String @db.VarChar(255) 
  name  String? @db.VarChar(255)
  function String @db.VarChar(255)
  section String @db.VarChar(255)
  line String @db.VarChar(255)
  dapartement String @db.VarChar(255)
}

model History {
  id    Int     @id @default(autoincrement())
  id_asset Int 
  id_employee  Int 
  condition  Boolean 
  created_at DateTime @default(now()) 
  division String @db.VarChar(100)
  status_unit String @db.VarChar(100)
  section String @db.VarChar(100)
  dapartement String @db.VarChar(100)
  line String @db.VarChar(100)
  reason String @db.VarChar(100)
}